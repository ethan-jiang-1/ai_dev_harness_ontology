# ==============================================================================
# SYNTHETIC FIXTURE — 5 tables / 13 columns / 11 classes, NOT real data.
# 生成于示例，数字是期望值，不是实测。引用前先读 ./README.md。
# ==============================================================================
@prefix : <https://ex.org/c#> .
@prefix sh: <http://www.w3.org/ns/shacl#> .
@prefix xsd: <http://www.w3.org/2001/XMLSchema#> .

:TagHasLevel a sh:NodeShape ;
  sh:targetClass :Tag ;
  sh:property [ sh:path :sensitivityLevel ; sh:minCount 1 ; sh:datatype xsd:integer ;
                sh:minInclusive 1 ; sh:maxInclusive 4 ] .

:HasTagClass a sh:NodeShape ;
  sh:targetSubjectsOf :hasTag ;
  sh:property [ sh:path :hasTag ; sh:nodeKind sh:IRI ] .

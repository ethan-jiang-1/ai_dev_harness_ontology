{
  "policy_version": "0.3.0",
  "fixture": "example/ 2026-11-10",
  "note": "10 条输入→期望；T9 是故意留的优先级空洞，不是失败样本。clearance 只记录，不参与判定。",
  "cases": [
    {
      "id": "T1",
      "principal": "analyst",
      "action": "read",
      "resource_kind": "column",
      "resource_level": 2,
      "clearance": 2,
      "expected_decision": "allow",
      "expected_reason": "policy_allow",
      "tests": "level<=2 允许；阈值是工程选择"
    },
    {
      "id": "T2",
      "principal": "analyst",
      "action": "read",
      "resource_kind": "column",
      "resource_level": 3,
      "clearance": 3,
      "expected_decision": "deny",
      "expected_reason": "policy_deny",
      "tests": "clearance=3 仍拒，证明 clearance 未被消费"
    },
    {
      "id": "T3",
      "principal": "analyst",
      "action": "read",
      "resource_kind": "column",
      "resource_level": null,
      "clearance": 2,
      "expected_decision": "deny",
      "expected_reason": "policy_deny",
      "tests": "未标注列拒；与 R7 同效，reason 不可区分"
    },
    {
      "id": "T4",
      "principal": "analyst",
      "action": "read",
      "resource_kind": "column",
      "resource_level": 4,
      "clearance": 4,
      "expected_decision": "deny",
      "expected_reason": "policy_deny",
      "tests": "最高级 + 高 clearance 仍拒"
    },
    {
      "id": "T5",
      "principal": "steward",
      "action": "read",
      "resource_kind": "column",
      "resource_level": 4,
      "clearance": 1,
      "expected_decision": "allow",
      "expected_reason": "policy_allow",
      "tests": "steward 不受 level 约束；clearance 再低也 allow"
    },
    {
      "id": "T6",
      "principal": "service",
      "action": "write",
      "resource_kind": "column",
      "resource_level": 1,
      "clearance": 5,
      "expected_decision": "deny",
      "expected_reason": "policy_deny",
      "tests": "写一律拒；这是策略，不是写路径实现"
    },
    {
      "id": "T7",
      "principal": "analyst",
      "action": "read",
      "resource_kind": "table",
      "resource_level": null,
      "clearance": 2,
      "expected_decision": "skip",
      "expected_reason": "table_subject_not_judged",
      "tests": "表不按列判；skip != allow"
    },
    {
      "id": "T8",
      "principal": "analyst",
      "action": "read",
      "resource_kind": "dataset",
      "resource_level": 3,
      "clearance": 2,
      "expected_decision": "skip",
      "expected_reason": "table_subject_not_judged",
      "tests": "kind 先于 level；若先跑 R2 会得 deny，此例即失败"
    },
    {
      "id": "T9",
      "principal": "steward",
      "action": "read",
      "resource_kind": "table",
      "resource_level": null,
      "clearance": 3,
      "expected_decision": "undetermined",
      "expected_reason": "priority_gap",
      "tests": "R4 vs R6 谁先未写；不要求唯一期望，要求实现显式报 undetermined"
    },
    {
      "id": "T10",
      "principal": "analyst",
      "action": "delete",
      "resource_kind": "column",
      "resource_level": 1,
      "clearance": 2,
      "expected_decision": "deny",
      "expected_reason": "default_deny",
      "tests": "未覆盖 action -> 默认拒绝"
    }
  ]
}

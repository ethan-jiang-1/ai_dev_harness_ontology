{
  "version": "0.4.0",
  "default_rule": "R7",
  "rules": [
    {"id": "R1", "priority": 10, "principal": "analyst", "action": "read", "kind": "column", "condition": {"level": {"gte": 1, "lte": 2}}, "effect": "allow", "obligation": "log"},
    {"id": "R2", "priority": 10, "principal": "analyst", "action": "read", "kind": "column", "condition": {"level": {"gte": 3, "lte": 4}}, "effect": "deny", "obligation": "log"},
    {"id": "R3", "priority": 10, "principal": "analyst", "action": "read", "kind": "column", "condition": {"level": {"eq": null}}, "effect": "deny", "obligation": "log"},
    {"id": "R4", "priority": 20, "principal": "steward", "action": "read", "kind": "any", "effect": "allow", "obligation": "log"},
    {"id": "R5", "priority": 20, "principal": "any", "action": "read", "kind": ["table", "dataset"], "effect": "skip", "reason": "table_subject_not_judged", "obligation": "log"},
    {"id": "R6", "priority": 10, "principal": "service", "action": "write", "kind": "any", "effect": "deny", "obligation": "log"},
    {"id": "R7", "priority": 99, "principal": "any", "action": "any", "kind": "any", "effect": "deny", "obligation": "log", "is_default": true},
    {"id": "R8", "priority": 10, "principal": "governance", "action": "read", "kind": "dataset", "effect": "allow", "obligation": "log"}
  ]
